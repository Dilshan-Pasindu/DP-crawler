<Window x:Class="WpfFixture.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DP Crawler WPF Fixture" Height="300" Width="460">
  <StackPanel Margin="16">
    <Button x:Name="SafeBtn" AutomationProperties.AutomationId="wpf-safe-btn" Content="View Summary" Click="OnSafeClick" Margin="0,0,0,8"/>
    <Button x:Name="DeleteBtn" AutomationProperties.AutomationId="wpf-delete-btn" Content="Delete All" Click="OnDeleteClick" Margin="0,0,0,8"/>
    <Button x:Name="DisabledBtn" AutomationProperties.AutomationId="wpf-disabled-btn" Content="Locked Control" IsEnabled="False" Margin="0,0,0,8"/>
    <CheckBox x:Name="OptBox" AutomationProperties.AutomationId="wpf-toggle-box" Content="Read Only Mode" Margin="0,0,0,8"/>
    <TextBlock x:Name="StatusText" AutomationProperties.AutomationId="wpf-status" Text="idle"/>
  </StackPanel>
</Window>
