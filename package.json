{
  "name": "dp-crawler",
  "version": "0.1.0",
  "description": "A safety-first, cross-platform UI crawler that discovers interactive elements, explores application behaviour, and produces evidence-backed diagnostic reports.",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "dpcrawl": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "commander": "14.0.0",
    "escape-html": "1.0.3",
    "pino": "9.7.0",
    "zod": "3.25.32"
  },
  "devDependencies": {
    "@types/escape-html": "1.0.4",
    "@types/node": "24.0.1",
    "fast-check": "4.1.1",
    "tsdown": "0.12.7",
    "typescript": "5.8.3",
    "vitest": "3.2.1"
  }
}
